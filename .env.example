# Copy to .env (never commit .env)
ZTM_API_KEY=put-your-key-here
ZTM_ENVIRONMENT=dev

# Local development writes to ./data/bronze
ZTM_STORAGE_BACKEND=local
ZTM_LOCAL_ROOT=data/bronze

# Switch to Azure later:
# ZTM_STORAGE_BACKEND=azure
# ZTM_AZURE_ACCOUNT_URL=https://<storageaccount>.blob.core.windows.net
# ZTM_AZURE_CONTAINER=bronze

# If the portal changes the endpoint, update this instead of the code:
# ZTM_API_BASE_URL=https://dane.um.warszawa.pl/api/action/get_ztm_lokalizacja_pojazdow

# If the API answers 403 to our program but not to curl, try a different User-Agent:
# ZTM_USER_AGENT=curl/8.5.0
