# Copy to .env (never commit .env)
ZTM_API_KEY=put-your-key-here
ZTM_ENVIRONMENT=dev

# Local development writes to ./data/bronze
ZTM_STORAGE_BACKEND=local
ZTM_LOCAL_ROOT=data/bronze

# Switch to Azure later:
# ZTM_STORAGE_BACKEND=azure
# ZTM_AZURE_ACCOUNT_URL=https://<storageaccount>.blob.core.windows.net
# ZTM_AZURE_CONTAINER=bronze

# If the portal migration changes the endpoint, update these instead of the code:
# ZTM_API_BASE_URL=https://api.um.warszawa.pl/api/action/busestrams_get/
# ZTM_VEHICLE_RESOURCE_ID=f2e5503e-927d-4ad3-9500-4ab9e55deb59
